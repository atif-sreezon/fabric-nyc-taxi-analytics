table fact_trips
	lineageTag: 432bfbbd-8bd2-4a68-becf-3ad4c80cdab5
	sourceLineageTag: [gold].[fact_trips]

	measure 'Total Trips' = COUNTROWS(fact_trips)
		formatString: 0
		lineageTag: 96553a10-554f-4e3a-85b4-df79e488f6ae

		changedProperty = Name

	measure 'Total Revenue' = SUM(fact_trips[total_amount])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		lineageTag: 916788c3-485c-46bd-900e-5712fcf899df

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-AU"}

	measure 'Total Fare' = SUM(fact_trips[fare_amount])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		lineageTag: 13883265-0ede-486c-82e5-4d490d7955d1

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-AU"}

	measure 'Avg Fare' = DIVIDE([Total Fare], [Total Trips])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		lineageTag: 4b2921db-0459-4bb7-bf90-de9a71b47789

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-AU"}

	measure 'Avg Trip Distance' = AVERAGE ( fact_trips[trip_distance] )
		lineageTag: ead7774e-7067-4321-8f22-915e6df99f1e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Trip Minutes' = AVERAGE ( fact_trips[trip_minutes] )
		lineageTag: bed39952-2677-4f25-a10b-4320049f506f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Tip %' = DIVIDE (SUM(fact_trips[tip_amount] ),SUM ( fact_trips[fare_amount]))
		lineageTag: abb9564a-d33e-480c-b704-4f242682af6e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per Mile' = DIVIDE ([Total Revenue], SUM ( fact_trips[trip_distance]))
		lineageTag: 577b08a2-4698-4490-ad6e-33249419ce08

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Passengers' = AVERAGE (fact_trips[passenger_count])
		lineageTag: 37af23e0-5115-426d-a005-8ac3002de910

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days in Selection' = DISTINCTCOUNT (dim_date[date])
		formatString: 0
		lineageTag: 1df6bf4f-d16d-45b3-9bbd-21e61f8a5eb4

		changedProperty = Name

	measure 'Avg Daily Trips' = DIVIDE ([Total Trips], [Days in Selection])
		lineageTag: 95772ae0-21cc-41b2-b8e5-b460dcf620f7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trips Prev Month' =
			CALCULATE( // Calculate the total trips for last month
			    [Total Trips],
			    DATEADD(dim_date[date], -1, MONTH) // Filter for last month selection
			)
		formatString: 0
		lineageTag: 7708ca00-ee15-4383-ac6c-cd7bb7ff2719

		changedProperty = Name

	measure 'Trips MoM %' =
			DIVIDE(
			    // Month on Month trip increase or decrease by %
			    [Total Trips] - [Trips Prev Month], [Trips Prev Month]
			    )
		lineageTag: df1d481a-b46f-4a52-9019-430c220ee9c4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekend Share %' =
			DIVIDE(
			    CALCULATE(
			        [Total Trips], dim_date[is_weekend]=TRUE()
			    ),
			    [Total Trips]
			)
		lineageTag: 77c12d03-e7ba-4449-a5c8-e2b7bd4e76f3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dropoff Trips' =
			CALCULATE(
			    [Total Trips],
			    USERELATIONSHIP(fact_trips[dropoff_zone_id], dim_zone[zone_id])
			)
		formatString: 0
		lineageTag: 4ef816e6-9a94-4000-b2bd-da297012393d

		changedProperty = Name

	measure 'Top Pickup Zone' =
			MAXX(
			    TOPN(1,VALUES(dim_zone[Zone]), [Total Trips]), dim_zone[Zone]
			)
		lineageTag: 0be178d4-a967-4fd0-a945-db3508e3e969

		changedProperty = Name

	measure 'Avg Temp C' = AVERAGE(fact_weather_daily[temp_mean_c])
		lineageTag: eb28ba80-622e-41a2-8695-cd5552ca69d2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Precip mm' = AVERAGE(fact_weather_daily[precipitation_mm])
		lineageTag: f3d02eeb-8002-4b92-bbb0-c4a9a9ccef4e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Daily Trips (Rain)' =
			CALCULATE(
			    [Avg Daily Trips], fact_weather_daily[is_rainy] = TRUE()
			    )
		lineageTag: 78aaf5d3-351c-424c-a8f4-ca347c87d6c4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Daily Trips (Dry)' =
			CALCULATE(
			    [Avg Daily Trips], fact_weather_daily[precip_category] = "Dry"
			)
		lineageTag: 9b0e5b65-d033-4bb5-8606-c336654f3283

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rain vs Dry %' =
			DIVIDE(
			    [Avg Daily Trips (Rain)] - [Avg Daily Trips (Dry)], [Avg Daily Trips (Dry)]
			)
		lineageTag: 1afb8f22-6c0f-4034-b295-9dcb56c17922

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

